# ========================================================
# ABS Student Enrollment Mini Portal - Environment Configuration
# ========================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=abs-portal-secret-key-change-in-production-2026
PORT=5000

# Database Settings
# DB_TYPE can be 'mysql' (default) or 'sqlite' (for quick testing without MySQL)
DB_TYPE=mysql

# MySQL Database Connection Parameters
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=student_portal

# Alternatively, set full connection string:
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/student_portal?charset=utf8mb4
