# Flask Settings
FLASK_APP=app.py
FLASK_DEBUG=True
SECRET_KEY=abs-portal-secret-key-change-in-production-2026
PORT=5000

# Database Settings
# Set DB_TYPE to 'sqlite' for quick local testing without MySQL running,
# or set to 'mysql' when your MySQL server / XAMPP is started.
DB_TYPE=sqlite

# MySQL Settings (Default XAMPP / WAMP / standard local MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=student_portal
